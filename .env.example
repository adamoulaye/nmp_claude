# Copier vers .env (JAMAIS commité). En prod : Azure Key Vault -> Databricks secret scope "nmp".
FINNHUB_API_KEY=
ALPACA_KEY_ID=
ALPACA_SECRET=
ALPACA_FEED=iex            # iex (gratuit) | sip (payant)
POLYGON_API_KEY=
NEWSAPI_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SEC_USER_AGENT="Prenom Nom email@exemple.com"   # obligatoire pour EDGAR
KAFKA_BOOTSTRAP=redpanda:9092
KAFKA_SASL_PASSWORD=       # chaîne de connexion Event Hubs en Azure
NMP_CATALOG=nmp_dev
TICKERS=AAPL,MSFT,NVDA,TSLA,AMZN,GOOGL,META,GME,AMC,JPM
BENCHMARK=SPY              # indice de référence du modèle de marché : ajouté automatiquement aux barres
DATA_DIR=data              # mode local : dossier des archives brutes, logs et tables Delta
